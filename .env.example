# Copy to .env to change these (optional). config.yaml holds everything else.
# The start scripts create .env from this file and set COMPOSE_PROFILES from
# `device:` in config.yaml, so plain `docker compose ...` commands keep working.
COMPOSE_PROFILES=gpu

# Port of the MCP server (http://<host>:MCP_PORT/mcp). The start scripts copy it from
# server.port in config.yaml, so change it there.
MCP_PORT=5005

# Base URL put into returned image links. Set it to an address other machines
# can reach, e.g. http://192.168.1.50:5005 (default: http://localhost:5005)
PUBLIC_URL=

# Optional Hugging Face token (only needed if downloads are rate limited)
HF_TOKEN=

# Optional folder whose images tools may read by file name (mounted read-only)
INPUTS_DIR=./inputs

# Prebuilt images: set to e.g. ghcr.io/<owner>/<repo> to pull instead of building locally
IMAGE_REPO=

# Build settings
# CUDA 12.8 needs NVIDIA driver 570+; 12.9.2 needs 575+; 13.x needs 580+
CUDA_VERSION=12.8.2
# Compile only for your GPU to build faster, e.g. "86-real" (RTX 30xx) or "120a-real" (RTX 50xx)
CUDA_ARCHS=75-virtual;80-virtual;86-real;89-real;90-virtual;120a-real
# Parallel compile jobs (each CUDA job can use 2-3 GB of RAM)
BUILD_JOBS=8
